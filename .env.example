# TrueFit-AI Environment Variables

# Server Port (default: 8000)
PORT=8000

# Database Connection URL
# 1. PostgreSQL (Local or Cloud like Render, Supabase, Neon, AWS RDS, Docker):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/truefit

# 2. SQLite (Default local fallback if DATABASE_URL is unset):
# DATABASE_URL=sqlite:///truefit.db

# Auto seed database on startup if empty (default: true)
DB_AUTO_SEED=true
